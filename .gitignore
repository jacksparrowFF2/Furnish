# macOS
.DS_Store

# 编辑器 / IDE
.vscode/
.idea/
*.swp

# Local generated deliverables and verification runs
.playwright-cli/
/output/
/verification.noindex/
/node_modules/
/debug.log
__pycache__/
*.pyc

# Machine-local recovery copies and interrupted atomic writes; projects stay tracked.
/.local/
/projects/.workspace-*.tmp
/projects/.workspace.lock
/projects/.workspace-owner-*
